# Telegram credentials for the contact form (used by app/api/contact/route.ts)
#
# Setup:
# 1. In Telegram, message @BotFather -> /newbot, and copy the token it gives you.
# 2. Send any message to your new bot, then get your chat id by messaging
#    @userinfobot (it replies with your numeric id), or visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id.
# 3. Set both values below in .env.local for local dev, and in the Vercel
#    project settings (Settings -> Environment Variables) for production.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
